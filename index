                await html2pdf().set(opt).from(clonedDoc).save();
                document.body.removeChild(cloneContainer);
                await recordSystemLog('Muat Turun PDF', `Berjaya memuat turun PDF: OPR_${safeTitle || 'Laporan_Rasmi'}.pdf`);
