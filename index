        // =========================================================================
        // 4. PEMBANTU FORMAT TEKS, HIASAN SVG & GALERI FOTO PINTAR (SMART COLLAGE)
        // =========================================================================
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function formatMultilineText(text, fallbackText, compact = false) {
            const raw = (text || '').trim();
            if (!raw) {
                return `<p class="text-[10.5px] text-slate-400 italic">${fallbackText}</p>`;
            }
            const lines = raw.split('\n').map(l => l.trim()).filter(Boolean);
            const textSize = compact ? 'text-[10px] leading-[1.38]' : 'text-[10.5px] leading-[1.42]';
            return lines.map(line => {
                const cleanLine = line.replace(/^[•\-\*]\s*/, '');
                const isBullet = /^[•\-\*]/.test(line) || lines.length > 1;
                if (isBullet) {
                    return `<div class="flex items-start gap-1.5 ${textSize} text-slate-800 mb-1">
                        <span class="font-extrabold mt-[0.5px]" style="color: var(--p-primary)">▸</span>
                        <span>${escapeHtml(cleanLine)}</span>
                    </div>`;
                }
                return `<p class="${textSize} text-slate-800 mb-1">${escapeHtml(cleanLine)}</p>`;
            }).join('');
        }

        function getHighlightQuote(impactText) {
            const raw = (impactText || '').trim();
            if (!raw) return 'Pelaksanaan program berjaya mencapai objektif dan memberi impak positif kepada semua peserta.';
            const firstLine = raw.split('\n').map(l => l.trim()).filter(Boolean)[0] || '';
            return firstLine.replace(/^[•\-\*]\s*/, '');
        }

        function getFrameClasses(frameType) {
            if (frameType === 'tajam') {
                return {
                    wrapper: 'rounded-none border border-slate-400 bg-white p-1',
                    imgRadius: 'rounded-none',
                    captionClass: 'text-[9px] text-slate-700 font-medium pt-1 text-center'
                };
            }
            if (frameType === 'polaroid') {
                return {
                    wrapper: 'rounded-sm border border-slate-200 bg-white p-1.5 pb-2 shadow-sm',
                    imgRadius: 'rounded-xs border border-slate-100',
                    captionClass: 'font-serif-formal italic text-[8.8px] text-slate-700 pt-1.5 text-center'
                };
            }
            // Default: 'bulat' (Sudut Bulat Moden)
            return {
                wrapper: 'rounded-xl overflow-hidden border border-slate-200/90 bg-slate-50/70 p-1',
                imgRadius: 'rounded-lg',
                captionClass: 'text-[9px] text-slate-600 font-semibold pt-1 px-1 text-center'
            };
        }

        function renderSmartPhotoCollage(photos, options = {}) {
            const { layoutMode = 'standard', maxHeight = 225 } = options;
            const count = photos.length;
            const fc = getFrameClasses(appState.photoFrame);
            const displayMode = appState.photoDisplayMode || 'full_original';

            if (count === 0) {
                return `
                    <div class="w-full border border-dashed border-slate-300 rounded-xl bg-slate-50/70 flex flex-col items-center justify-center p-4 text-center" style="height: ${maxHeight}px;">
                        <svg class="w-7 h-7 text-slate-300 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <p class="text-[10.5px] font-bold text-slate-400">Ruangan Kolaj Gambar Pintar (1 – 4 Gambar)</p>
                        <p class="text-[9.5px] text-slate-400">Setiap gambar akan dipaparkan 100% penuh mengikut nisbah asal tanpa terpotong.</p>
                    </div>
                `;
            }

            // Penjana kad gambar tunggal mengikut ketetapan paparan (Tanpa Potong / Seragam / Tersuai)
            const renderPhotoCard = (photo, idx, slotMaxHeight, extraCardClass = '') => {
                let containerStyle = '';
                let imgClass = 'w-full h-full object-contain';
                let imgInlineStyle = '';

                if (displayMode === 'full_original') {
                    // Saiz Penuh Asal (Tanpa Potong): tinggi berkadar terus dengan nisbah asal gambar, dihadkan oleh slotMaxHeight supaya muat 1 muka surat A4
                    containerStyle = `max-height: ${slotMaxHeight}px; min-height: 56px;`;
                    imgClass = 'w-auto h-auto max-w-full object-contain mx-auto block';
                    imgInlineStyle = `max-height: ${slotMaxHeight}px;`;
                } else if (displayMode === 'uniform_contain') {
                    // Ketinggian Tetap Seragam (Penuh): bingkai seragam dengan object-contain agar gambar tidak terpotong
                    containerStyle = `height: ${slotMaxHeight}px;`;
                    imgClass = 'w-full h-full object-contain mx-auto block';
                } else {
                    // Ketetapan Saiz Tersuai (Tinggi Maksimum, Nisbah Bingkai & Mod Fit)
                    const userMaxH = Math.min(slotMaxHeight + 25, appState.customPhotoHeight || 135);
                    const fitClass = appState.customPhotoFit === 'cover' ? 'object-cover' : 'object-contain';
                    if (appState.customPhotoRatio && appState.customPhotoRatio !== 'auto') {
                        containerStyle = `aspect-ratio: ${appState.customPhotoRatio}; max-height: ${userMaxH}px; width: 100%;`;
                        imgClass = `w-full h-full ${fitClass} mx-auto block`;
                    } else {
                        if (appState.customPhotoFit === 'cover') {
                            containerStyle = `height: ${userMaxH}px; width: 100%;`;
                            imgClass = 'w-full h-full object-cover mx-auto block';
                        } else {
                            containerStyle = `max-height: ${userMaxH}px; min-height: 52px;`;
                            imgClass = 'w-auto h-auto max-w-full object-contain mx-auto block';
                            imgInlineStyle = `max-height: ${userMaxH}px;`;
                        }
                    }
                }

                return `
                    <div class="${fc.wrapper} ${extraCardClass} flex flex-col justify-between overflow-hidden">
                        <div class="w-full overflow-hidden bg-[#f8fafc] relative flex items-center justify-center ${fc.imgRadius}" style="${containerStyle}">
                            <img src="${photo.src}" alt="Dokumentasi ${idx + 1}" class="${imgClass}" style="${imgInlineStyle}">
                            <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded text-[8px] font-extrabold text-white shadow-xs" style="background-color: var(--p-primary)">0${idx + 1}</span>
                        </div>
                        <p class="${fc.captionClass} line-clamp-1 leading-tight">
                            ${escapeHtml(photo.caption || `Gambar Dokumentasi ${idx + 1}`)}
                        </p>
                    </div>
                `;
            };

            // 1 Gambar: Paparan Wira Penuh tanpa terpotong
            if (count === 1) {
                return `
                    <div class="w-full">
                        ${renderPhotoCard(photos[0], 0, maxHeight - 26)}
                    </div>
                `;
            }

            // 2 Gambar: Beriringan atau Bertingkat mengikut mod
            if (count === 2) {
                if (layoutMode === 'vertical-stack') {
                    const eachH = Math.floor((maxHeight - 8) / 2) - 24;
                    return `
                        <div class="grid grid-cols-1 gap-2 items-center">
                            ${photos.map((p, i) => renderPhotoCard(p, i, eachH)).join('')}
                        </div>
                    `;
                }
                return `
                    <div class="grid grid-cols-2 gap-2.5 items-stretch">
                        ${photos.map((p, i) => renderPhotoCard(p, i, maxHeight - 26)).join('')}
                    </div>
                `;
            }

            // 3 Gambar: Gaya Majalah (1 Besar di Kiri + 2 Kecil Bertingkat di Kanan)
            if (count === 3) {
                const bigH = maxHeight - 26;
                const smallH = Math.floor((maxHeight - 8) / 2) - 24;
                return `
                    <div class="grid grid-cols-12 gap-2.5 items-stretch">
                        <div class="col-span-7 flex flex-col">
                            ${renderPhotoCard(photos[0], 0, bigH, 'flex-1')}
                        </div>
                        <div class="col-span-5 flex flex-col gap-2 justify-between">
                            ${renderPhotoCard(photos[1], 1, smallH)}
                            ${renderPhotoCard(photos[2], 2, smallH)}
                        </div>
                    </div>
                `;
            }

            // 4 Gambar: Grid 2x2 Seimbang atau Gaya Editorial Asimetri
            const cellH = Math.floor((maxHeight - 8) / 2) - 24;
            if (layoutMode === 'editorial-asymmetric') {
                return `
                    <div class="grid grid-cols-12 gap-2 items-stretch">
                        <div class="col-span-6 flex flex-col">${renderPhotoCard(photos[0], 0, cellH, 'flex-1')}</div>
                        <div class="col-span-6 flex flex-col">${renderPhotoCard(photos[1], 1, cellH, 'flex-1')}</div>
                        <div class="col-span-6 flex flex-col">${renderPhotoCard(photos[2], 2, cellH, 'flex-1')}</div>
                        <div class="col-span-6 flex flex-col">${renderPhotoCard(photos[3], 3, cellH, 'flex-1')}</div>
                    </div>
                `;
            }

            return `
                <div class="grid grid-cols-2 gap-2 items-stretch">
                    ${photos.map((p, i) => renderPhotoCard(p, i, cellH)).join('')}
                </div>
            `;
        }

        // =========================================================================
        // 5. ENJIN PENJANA 5 REKABENTUK LAPORAN RASMI KREATIF & DINAMIK (A4)
