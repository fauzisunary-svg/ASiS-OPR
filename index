        let customZoom = null; // null bermaksud auto-fit

        // =========================================================================
        // 2. PENJANA SVG GAMBAR CONTOH (PELBAGAI NISBAH: LANDSKAP & POTRET)
        // =========================================================================
        function createSampleIllustration(title, bgHex, accentHex, iconType, orientation = 'landscape') {
            const isPortrait = orientation === 'portrait';
            const w = isPortrait ? 280 : 420;
            const h = isPortrait ? 380 : 250;
            const cx = Math.round(w / 2);
            const cy = Math.round(h * 0.44);

            const icons = {
                speech: `<circle cx="${cx}" cy="${cy - 22}" r="24" fill="${accentHex}"/><path d="M${cx - 45} ${cy + 58} C${cx - 45} ${cy + 18}, ${cx + 45} ${cy + 18}, ${cx + 45} ${cy + 58} Z" fill="${accentHex}"/><rect x="${cx - 70}" y="${cy + 58}" width="140" height="52" rx="6" fill="#ffffff" opacity="0.9"/><rect x="${cx - 12}" y="${cy + 13}" width="24" height="45" fill="#cbd5e1"/>`,
                group: `<circle cx="${cx - 60}" cy="${cy - 8}" r="20" fill="${accentHex}"/><path d="M${cx - 95} ${cy + 62} C${cx - 95} ${cy + 27}, ${cx - 25} ${cy + 27}, ${cx - 25} ${cy + 62} Z" fill="${accentHex}"/><circle cx="${cx + 60}" cy="${cy - 8}" r="20" fill="${accentHex}"/><path d="M${cx + 25} ${cy + 62} C${cx + 25} ${cy + 27}, ${cx + 95} ${cy + 27}, ${cx + 95} ${cy + 62} Z" fill="${accentHex}"/><circle cx="${cx}" cy="${cy - 18}" r="24" fill="#ffffff"/><path d="M${cx - 45} ${cy + 67} C${cx - 45} ${cy + 22}, ${cx + 45} ${cy + 22}, ${cx + 45} ${cy + 67} Z" fill="#ffffff"/>`,
                workshop: `<rect x="${cx - 105}" y="${cy - 45}" width="210" height="125" rx="10" fill="#ffffff" opacity="0.95"/><rect x="${cx - 82}" y="${cy - 24}" width="90" height="12" rx="4" fill="${bgHex}"/><rect x="${cx - 82}" y="${cy - 2}" width="145" height="8" rx="4" fill="#94a3b8"/><rect x="${cx - 82}" y="${cy + 14}" width="125" height="8" rx="4" fill="#94a3b8"/><circle cx="${cx + 65}" cy="${cy + 32}" r="22" fill="${accentHex}"/>`,
                award: `<circle cx="${cx}" cy="${cy - 12}" r="42" fill="${accentHex}"/><polygon points="${cx},${cy - 42} ${cx + 9},${cy - 20} ${cx + 32},${cy - 18} ${cx + 14},${cy - 3} ${cx + 19},${cy + 19} ${cx},${cy + 7} ${cx - 19},${cy + 19} ${cx - 14},${cy - 3} ${cx - 32},${cy - 18} ${cx - 9},${cy - 20}" fill="#ffffff"/><path d="M${cx - 26} ${cy + 26} L${cx - 42} ${cy + 80} L${cx - 15} ${cy + 66} L${cx} ${cy + 80} L${cx} ${cy + 30} Z" fill="#ffffff" opacity="0.9"/><path d="M${cx + 26} ${cy + 26} L${cx + 42} ${cy + 80} L${cx + 15} ${cy + 66} L${cx} ${cy + 80} L${cx} ${cy + 30} Z" fill="#ffffff" opacity="0.8"/>`
            };
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">
                <defs>
                    <linearGradient id="g_${iconType}_${orientation}" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="${bgHex}"/>
                        <stop offset="100%" stop-color="#0f172a"/>
                    </linearGradient>
                </defs>
                <rect width="${w}" height="${h}" fill="url(#g_${iconType}_${orientation})"/>
                <rect x="10" y="10" width="${w - 20}" height="${h - 20}" rx="8" fill="none" stroke="#ffffff" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="6 4"/>
                <text x="${cx}" y="30" font-family="sans-serif" font-size="10" font-weight="bold" fill="#ffffff" opacity="0.75" text-anchor="middle">${isPortrait ? 'FORMAT POTRET (3:4) • 100% PENUH' : 'FORMAT LANDSKAP (16:10) • 100% PENUH'}</text>
                ${icons[iconType] || icons.speech}
                <rect x="0" y="${h - 40}" width="${w}" height="40" fill="#000000" opacity="0.5"/>
                <text x="${cx}" y="${h - 15}" font-family="sans-serif" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">${title}</text>
            </svg>`;
            return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
        }

        function createSampleLogo() {
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                <path d="M60 8 L106 26 V62 C106 89 86 107 60 114 C34 107 14 89 14 62 V26 Z" fill="#1e3a8a" stroke="#d97706" stroke-width="5"/>
                <circle cx="60" cy="54" r="20" fill="#ffffff"/>
                <path d="M36 86 Q60 72 84 86" stroke="#d97706" stroke-width="5" fill="none" stroke-linecap="round"/>
                <text x="60" y="59" font-family="serif" font-size="16" font-weight="bold" fill="#1e3a8a" text-anchor="middle">OPR</text>
            </svg>`;
            return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
        }

        // =========================================================================
        // 3. FUNGSI KAWALAN INPUT & MUAT NAIK FAIL
        // =========================================================================
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const colors = {
                info: 'bg-slate-900 text-white',
                success: 'bg-emerald-700 text-white',
                warning: 'bg-amber-600 text-white',
                error: 'bg-rose-700 text-white'
            };
            toast.className = `${colors[type] || colors.info} px-4 py-3 rounded-xl shadow-lg text-xs font-semibold flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<span>${message}</span>`;
            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }

        function handleLogoUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                appState.logo = e.target.result;
                updateLogoUI();
                renderDocument();
                showToast('Logo organisasi berjaya dimuat naik.', 'success');
            };
            reader.readAsDataURL(file);
        }

        function removeLogo() {
            appState.logo = '';
            document.getElementById('input-logo').value = '';
            updateLogoUI();
            renderDocument();
        }

        function updateLogoUI() {
            const img = document.getElementById('logo-thumb-img');
            const icon = document.getElementById('logo-placeholder-icon');
            const btnRemove = document.getElementById('btn-remove-logo');
            if (appState.logo) {
                img.src = appState.logo;
                img.classList.remove('hidden');
                icon.classList.add('hidden');
                btnRemove.classList.remove('hidden');
            } else {
                img.src = '';
                img.classList.add('hidden');
                icon.classList.remove('hidden');
                btnRemove.classList.add('hidden');
            }
        }

        function handlePhotosUpload(event) {
            const files = Array.from(event.target.files);
            if (!files.length) return;

            const remainingSlots = 4 - appState.photos.length;
            if (remainingSlots <= 0) {
                showToast('Had maksimum 4 keping gambar telah dicapai.', 'warning');
                event.target.value = '';
                return;
            }

            const filesToProcess = files.slice(0, remainingSlots);
            if (files.length > remainingSlots) {
                showToast(`Hanya ${remainingSlots} gambar pertama ditambah (had 4 gambar).`, 'warning');
            }

            let processed = 0;
            filesToProcess.forEach((file, idx) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    appState.photos.push({
                        src: e.target.result,
                        caption: `Gambar ${appState.photos.length + 1}: Aktiviti sepanjang program berlangsung.`
                    });
                    processed++;
                    if (processed === filesToProcess.length) {
                        renderPhotoEditorList();
                        renderDocument();
                        showToast(`${processed} gambar berjaya dimuat naik.`, 'success');
                    }
                };
                reader.readAsDataURL(file);
            });
            event.target.value = '';
        }

        function updatePhotoCaption(index, value) {
            if (appState.photos[index]) {
                appState.photos[index].caption = value;
                renderDocument();
            }
        }

        function removePhoto(index) {
            appState.photos.splice(index, 1);
            renderPhotoEditorList();
            renderDocument();
        }

        function renderPhotoEditorList() {
