        // =========================================================================
        // 6. PENGSKALAAN PRATONTON A4 RESPONSIF & ZOOM
        // =========================================================================
        function updatePreviewScale() {
            const wrapper = document.getElementById('preview-wrapper');
            const scaler = document.getElementById('preview-scaler');
            const doc = document.getElementById('a4-document');
            const zoomLabel = document.getElementById('zoom-label');

            if (!wrapper || !scaler || !doc || wrapper.offsetParent === null) return;

            // Saiz 210mm dalam piksel pada 96 DPI (~793.7px)
            const a4WidthPx = 793.7;
            const a4HeightPx = 1122.5;
            const availableWidth = wrapper.clientWidth - 48; // padding

            let scale = customZoom !== null
                ? customZoom
                : Math.min(1, Math.max(0.35, availableWidth / a4WidthPx));

            doc.style.transform = `scale(${scale})`;
            scaler.style.width = `${a4WidthPx * scale}px`;
            scaler.style.height = `${a4HeightPx * scale}px`;

            zoomLabel.textContent = customZoom !== null
                ? `${Math.round(scale * 100)}%`
                : `Auto (${Math.round(scale * 100)}%)`;
        }

        function adjustZoom(delta) {
            const doc = document.getElementById('a4-document');
            const currentTransform = doc.style.transform;
            const match = currentTransform.match(/scale\(([^)]+)\)/);
            const current = match ? parseFloat(match[1]) : 0.8;
            customZoom = Math.min(1.4, Math.max(0.35, +(current + delta).toFixed(2)));
            updatePreviewScale();
        }

        function resetZoom() {
            customZoom = null;
            updatePreviewScale();
        }

        function switchMobileTab(tab) {
            const editorPanel = document.getElementById('panel-editor');
            const previewPanel = document.getElementById('panel-preview');
            const tabEdit = document.getElementById('tab-edit');
            const tabPreview = document.getElementById('tab-preview');

            if (tab === 'edit') {
                editorPanel.classList.remove('hidden');
                previewPanel.classList.add('hidden');
                previewPanel.classList.remove('flex');
                tabEdit.className = 'flex-1 py-2 text-xs font-bold rounded-lg bg-blue-900 text-white transition';
                tabPreview.className = 'flex-1 py-2 text-xs font-bold rounded-lg bg-slate-100 text-slate-600 transition';
            } else {
                editorPanel.classList.add('hidden');
                previewPanel.classList.remove('hidden');
                previewPanel.classList.add('flex');
                tabPreview.className = 'flex-1 py-2 text-xs font-bold rounded-lg bg-blue-900 text-white transition';
                tabEdit.className = 'flex-1 py-2 text-xs font-bold rounded-lg bg-slate-100 text-slate-600 transition';
                setTimeout(updatePreviewScale, 50);
            }
        }

        // =========================================================================
        // 7. PENJANAAN & MUAT TURUN PDF SATU MUKA SURAT A4
        // =========================================================================
        function printDirect() {
            window.print();
        }

        async function generatePDF() {
            const btn = document.getElementById('btn-download-pdf');
            const originalHtml = btn.innerHTML;

            // Jika library html2pdf tidak tersedia, terus guna window.print()
            if (typeof html2pdf === 'undefined') {
                window.print();
                return;
            }

            try {
                btn.disabled = true;
                btn.innerHTML = `<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg><span>Menjana PDF...</span>`;
                showToast('Sedang menjana fail PDF A4 berkualiti tinggi...', 'info');

                // Klon elemen A4 pada skala 1:1 (tanpa transform scale) supaya hasil PDF tepat 210mm x 297mm
                const sourceDoc = document.getElementById('a4-document');
                const cloneContainer = document.createElement('div');
                cloneContainer.style.position = 'fixed';
                cloneContainer.style.left = '-10000px';
                cloneContainer.style.top = '0';
                cloneContainer.style.width = '210mm';
                cloneContainer.style.height = '296.8mm'; // Sedikit kurang dari 297mm bagi mengelak halaman ke-2 kosong
                cloneContainer.style.overflow = 'hidden';
                cloneContainer.style.background = '#ffffff';

                const clonedDoc = sourceDoc.cloneNode(true);
                clonedDoc.style.transform = 'none';
                clonedDoc.style.boxShadow = 'none';
                clonedDoc.style.margin = '0';
                clonedDoc.style.width = '210mm';
                clonedDoc.style.height = '296.8mm';
                cloneContainer.appendChild(clonedDoc);
                document.body.appendChild(cloneContainer);

                const safeTitle = (appState.title || 'One_Page_Report')
                    .replace(/[^a-zA-Z0-9\s-_]/g, '')
                    .trim()
                    .replace(/\s+/g, '_')
                    .substring(0, 45);

                const opt = {
                    margin: 0,
                    filename: `OPR_${safeTitle || 'Laporan_Rasmi'}.pdf`,
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: {
                        scale: 2,
                        useCORS: true,
                        letterRendering: true,
                        width: 794,
                        height: 1122
                    },
                    jsPDF: {
                        unit: 'mm',
                        format: 'a4',
                        orientation: 'portrait'
                    }
                };

                await html2pdf().set(opt).from(clonedDoc).save();
                document.body.removeChild(cloneContainer);
                showToast('Fail PDF One Page Report berjaya dimuat turun!', 'success');
            } catch (err) {
                console.error('Ralat menjana PDF:', err);
                showToast('Membuka dialog cetakan PDF pelayar sebagai alternatif...', 'warning');
                window.print();
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

        // =========================================================================
        // 8. INISIALISASI APLIKASI
        // =========================================================================
        window.addEventListener('DOMContentLoaded', () => {
            loadSampleData();
            updatePreviewScale();
        });

        window.addEventListener('resize', () => {
            updatePreviewScale();
        });
