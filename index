        // =========================================================================
        // 8. PANGKALAN DATA TEMPATAN (INDEXEDDB + SANDARAN), PENGGUNA & ARKIB OPR
        // =========================================================================
        const DB_NAME = 'SistemOPRRasmiDB_v1';
        const DB_VERSION = 1;
        let dbInstance = null;
        let currentUser = null;
        let cachedUsers = [];
        let cachedLogs = [];
        let cachedArchive = [];

        const templateNamesMap = {
            editorial: 'Editorial Majalah',
            infografik: 'Infografik Moden',
            eksekutif_split: 'Eksekutif Korporat',
            klasik: 'Klasik Berprestij',
            bento: 'Grid Modular Bento'
        };

        function formatTimestampMY(dateObj = new Date()) {
            const pad = (n) => String(n).padStart(2, '0');
            return `${pad(dateObj.getDate())}/${pad(dateObj.getMonth() + 1)}/${dateObj.getFullYear()} ${pad(dateObj.getHours())}:${pad(dateObj.getMinutes())}:${pad(dateObj.getSeconds())}`;
        }

        function initDatabase() {
            return new Promise((resolve) => {
                if (!window.indexedDB) {
                    resolve(null);
                    return;
                }
                const request = indexedDB.open(DB_NAME, DB_VERSION);
                request.onupgradeneeded = (event) => {
                    const db = event.target.result;
                    if (!db.objectStoreNames.contains('users')) {
                        db.createObjectStore('users', { keyPath: 'id' });
                    }
                    if (!db.objectStoreNames.contains('logs')) {
                        db.createObjectStore('logs', { keyPath: 'id' });
                    }
                    if (!db.objectStoreNames.contains('opr_archive')) {
                        db.createObjectStore('opr_archive', { keyPath: 'id' });
                    }
                };
                request.onsuccess = (event) => {
                    dbInstance = event.target.result;
                    resolve(dbInstance);
                };
                request.onerror = () => {
                    resolve(null);
                };
            });
        }

        function dbPut(storeName, item) {
            return new Promise((resolve) => {
                if (!dbInstance) {
                    try {
                        const existing = JSON.parse(localStorage.getItem(`opr_fallback_${storeName}`) || '[]');
                        const idx = existing.findIndex(x => x.id === item.id);
                        if (idx >= 0) existing[idx] = item; else existing.push(item);
                        localStorage.setItem(`opr_fallback_${storeName}`, JSON.stringify(existing));
                    } catch (e) {}
                    resolve(item);
                    return;
                }
                const tx = dbInstance.transaction(storeName, 'readwrite');
                tx.objectStore(storeName).put(item);
                tx.oncomplete = () => resolve(item);
                tx.onerror = () => resolve(item);
            });
        }

        function dbDelete(storeName, id) {
            return new Promise((resolve) => {
                if (!dbInstance) {
                    try {
                        const existing = JSON.parse(localStorage.getItem(`opr_fallback_${storeName}`) || '[]');
                        localStorage.setItem(`opr_fallback_${storeName}`, JSON.stringify(existing.filter(x => x.id !== id)));
                    } catch (e) {}
                    resolve();
                    return;
                }
                const tx = dbInstance.transaction(storeName, 'readwrite');
                tx.objectStore(storeName).delete(id);
                tx.oncomplete = () => resolve();
                tx.onerror = () => resolve();
            });
        }

        function dbGetAll(storeName) {
            return new Promise((resolve) => {
                if (!dbInstance) {
                    try {
                        resolve(JSON.parse(localStorage.getItem(`opr_fallback_${storeName}`) || '[]'));
                    } catch (e) {
                        resolve([]);
                    }
                    return;
                }
                const tx = dbInstance.transaction(storeName, 'readonly');
                const req = tx.objectStore(storeName).getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => resolve([]);
            });
        }

        async function refreshAllCachedData() {
            cachedUsers = await dbGetAll('users');
            cachedLogs = (await dbGetAll('logs')).sort((a, b) => (b.createdAtMs || 0) - (a.createdAtMs || 0));
            cachedArchive = (await dbGetAll('opr_archive')).sort((a, b) => (b.savedAtMs || 0) - (a.savedAtMs || 0));

            const badge = document.getElementById('nav-archive-count');
            if (badge) badge.textContent = cachedArchive.length;

