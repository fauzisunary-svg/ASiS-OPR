            const headers = ['Kod Rekod', 'Tajuk Program', 'Kategori', 'Organisasi', 'Tarikh Program', 'Lokasi', 'Templat', 'Status', 'Dijana Oleh', 'ID Kakitangan', 'Tarikh Simpan'];
            const rows = cachedArchive.map(r => [
                r.recordCode, r.title, r.category, r.org, r.date, r.venue,
                templateNamesMap[r.template] || r.template, r.status,
                r.createdByName, r.createdByStaffId, r.savedAt
            ].map(csvSafe).join(','));
            downloadTextFile('Senarai_Arkib_OPR.csv', '\uFEFF' + [headers.join(','), ...rows].join('\n'), 'text/csv;charset=utf-8;');
            showToast('Senarai Arkib OPR berjaya dieksport ke CSV.', 'success');
        }

        function exportUsersCSV() {
            const headers = ['Nama Penuh', 'ID Kakitangan', 'Jawatan', 'Bahagian/Organisasi', 'E-mel', 'No. Telefon', 'Tarikh Daftar'];
            const rows = cachedUsers.map(u => [
                u.name, u.staffId, u.role, u.org, u.email, u.phone, u.registeredAt
            ].map(csvSafe).join(','));
            downloadTextFile('Rekod_Pengguna_Sistem_OPR.csv', '\uFEFF' + [headers.join(','), ...rows].join('\n'), 'text/csv;charset=utf-8;');
            showToast('Rekod Pengguna Berdaftar berjaya dieksport ke CSV.', 'success');
        }

        function exportLogsCSV() {
            const headers = ['Tarikh & Masa', 'Nama Pengguna', 'ID Kakitangan', 'Jawatan', 'Organisasi', 'Aktiviti', 'Butiran Rekod'];
            const rows = cachedLogs.map(l => [
                l.timestamp, l.userName, l.staffId, l.userRole, l.userOrg, l.action, l.details
            ].map(csvSafe).join(','));
            downloadTextFile('Log_Penggunaan_Sistem_OPR.csv', '\uFEFF' + [headers.join(','), ...rows].join('\n'), 'text/csv;charset=utf-8;');
            showToast('Log Penggunaan Sistem berjaya dieksport ke CSV.', 'success');
        }

        function exportFullBackupJSON() {
            const backupPayload = {
                exportedAt: formatTimestampMY(new Date()),
                users: cachedUsers,
                logs: cachedLogs,
                opr_archive: cachedArchive
            };
            downloadTextFile('Sandaran_Penuh_Sistem_OPR.json', JSON.stringify(backupPayload, null, 2), 'application/json');
            showToast('Fail sandaran penuh (JSON) berjaya dimuat turun.', 'success');
        }

        function importFullBackupJSON(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = async (e) => {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (Array.isArray(parsed.users)) {
                        for (const u of parsed.users) await dbPut('users', u);
                    }
                    if (Array.isArray(parsed.logs)) {
                        for (const l of parsed.logs) await dbPut('logs', l);
                    }
                    if (Array.isArray(parsed.opr_archive)) {
                        for (const r of parsed.opr_archive) await dbPut('opr_archive', r);
                    }
                    await refreshAllCachedData();
                    renderArchiveList();
                    showToast('Data sandaran (JSON) berjaya dipulihkan ke sistem!', 'success');
                } catch (err) {
                    showToast('Fail JSON tidak sah atau rosak.', 'error');
                }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

        // =========================================================================
        // 9. INISIALISASI APLIKASI
        // =========================================================================
        window.addEventListener('DOMContentLoaded', async () => {
            await initDatabase();
            await refreshAllCachedData();
            loadSampleData();
            updatePreviewScale();

            // Pulihkan sesi aktif dalam tab pelayar yang sama jika ada
            const activeId = sessionStorage.getItem('opr_active_user_id');
            if (activeId) {
                const existingUser = cachedUsers.find(u => u.id === activeId);
                if (existingUser) {
                    await completeUserSession(existingUser, false);
                }
            }
        });

        window.addEventListener('resize', () => {
            updatePreviewScale();
        });
    </script>
</body>
