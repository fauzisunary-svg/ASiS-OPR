        async function recordSystemLog(actionType, details, userOverride = null) {
            const actor = userOverride || currentUser || {
                name: 'Pengguna Sistem',
                staffId: 'TETAMU',
                role: 'Pelapor',
                org: 'Umum'
            };
            const now = new Date();
            const logEntry = {
