<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Penjana One Page Report (OPR) Rasmi</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans, Merriweather & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;0,900;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- html2pdf.js untuk muat turun PDF terus -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <style>
        :root {
            --theme-primary: #1e3a8a;
            --theme-secondary: #1e40af;
            --theme-light: #eff6ff;
            --theme-accent: #d97706;
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            background-color: #f1f5f9;
        }

        .font-serif-formal {
            font-family: 'Merriweather', serif;
        }

        .font-inter {
            font-family: 'Inter', sans-serif;
        }

        /* Saiz Sebenar Kertas A4 (210mm x 297mm) */
        .a4-page {
            width: 210mm;
            height: 297mm;
            min-width: 210mm;
            min-height: 297mm;
            max-width: 210mm;
            max-height: 297mm;
            background: #ffffff;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.12), 0 10px 10px -5px rgba(0, 0, 0, 0.06);
            overflow: hidden;
            position: relative;
            box-sizing: border-box;
            transform-origin: top center;
            transition: transform 0.2s ease;
        }

        /* Custom Scrollbar untuk Panel Borang */
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Konfigurasi Khas Cetakan & Save as PDF */
        @media print {
            @page {
                size: A4 portrait;
                margin: 0;
            }
            html, body {
                width: 210mm;
                height: 297mm;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                overflow: hidden !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print {
                display: none !important;
            }
            #preview-wrapper {
                padding: 0 !important;
                margin: 0 !important;
                background: transparent !important;
                overflow: visible !important;
                display: block !important;
                width: 210mm !important;
                height: 297mm !important;
            }
            #preview-scaler {
                transform: none !important;
                width: 210mm !important;
                height: 297mm !important;
                margin: 0 !important;
            }
            .a4-page {
                box-shadow: none !important;
                margin: 0 !important;
                transform: none !important;
                width: 210mm !important;
                height: 297mm !important;
                page-break-after: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body class="text-slate-800 antialiased selection:bg-blue-100 selection:text-blue-900">

    <!-- Notifikasi Toast (Gantian kepada alert) -->
    <div id="toast-container" class="no-print fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Bar Navigasi Atas -->
    <header class="no-print sticky top-0 z-30 bg-white border-b border-slate-200 px-4 lg:px-6 py-3 flex flex-wrap items-center justify-between gap-3 shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-900 text-white flex items-center justify-center shadow-sm">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">Penjana One Page Report (OPR)</h1>
                    <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-800 border border-blue-200">Edisi Kreatif & Rasmi</span>
                </div>
                <p class="text-xs text-slate-500">Sistem Pelaporan Satu Muka Surat Automatik • Format Piawai A4</p>
            </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
            <button type="button" onclick="loadSampleData()" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs sm:text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition cursor-pointer">
                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <span>Isi Contoh Data</span>
            </button>

            <button type="button" onclick="resetForm()" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs sm:text-sm font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-xl transition cursor-pointer" title="Kosongkan Borang">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                <span class="hidden md:inline">Set Semula</span>
            </button>

            <button type="button" onclick="printDirect()" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs sm:text-sm font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-xl transition cursor-pointer" title="Cetak atau Simpan PDF melalui Pelayar">
                <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                <span class="hidden sm:inline">Cetak</span>
            </button>

            <button type="button" id="btn-download-pdf" onclick="generatePDF()" class="inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-bold text-white bg-blue-900 hover:bg-blue-800 rounded-xl shadow-sm transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                <span>Jana & Muat Turun PDF</span>
            </button>
        </div>
    </header>

    <!-- Tab Navigasi Mudah Alih (Mobile View Switcher) -->
    <div class="no-print lg:hidden bg-white border-b border-slate-200 px-4 py-2 flex gap-2">
        <button type="button" id="tab-edit" onclick="switchMobileTab('edit')" class="flex-1 py-2 text-xs font-bold rounded-lg bg-blue-900 text-white transition">
            1. Isi Maklumat & Rekabentuk
        </button>
        <button type="button" id="tab-preview" onclick="switchMobileTab('preview')" class="flex-1 py-2 text-xs font-bold rounded-lg bg-slate-100 text-slate-600 transition">
            2. Pratonton Laporan A4
        </button>
    </div>

    <!-- Ruang Kerja Utama (Split Screen) -->
    <main class="flex flex-col lg:flex-row lg:h-[calc(100vh-65px)] overflow-hidden">
        
        <!-- PANEL KIRI: Borang Input & Tetapan Rekabentuk -->
        <section id="panel-editor" class="no-print w-full lg:w-[460px] xl:w-[500px] bg-white border-r border-slate-200 flex-shrink-0 overflow-y-auto custom-scrollbar p-4 sm:p-6 space-y-6">
            
            <!-- Seksyen 1: Pilihan Rekabentuk & Warna Tema -->
            <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-4 space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-6 h-6 rounded-lg bg-blue-900 text-white text-xs flex items-center justify-center font-bold">1</span>
                        Rekabentuk, Gaya Bingkai & Tema
                    </h2>
                </div>

                <!-- 5 Pilihan Template Kreatif & Rasmi -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <button type="button" onclick="setTemplate('editorial')" id="tpl-btn-editorial" class="tpl-btn text-left p-3 rounded-xl border-2 border-blue-900 bg-blue-50/60 transition cursor-pointer">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-bold text-slate-900">Editorial Majalah</span>
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-900 tpl-dot"></span>
                        </div>
                        <p class="text-[11px] text-slate-500 leading-tight">Kolum asimetri ala penerbitan korporat, petikan impak & kolaj bertingkat.</p>
                    </button>

                    <button type="button" onclick="setTemplate('infografik')" id="tpl-btn-infografik" class="tpl-btn text-left p-3 rounded-xl border-2 border-slate-200 bg-white hover:border-slate-300 transition cursor-pointer">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-bold text-slate-900">Infografik Moden</span>
                            <span class="w-2.5 h-2.5 rounded-full bg-transparent tpl-dot"></span>
                        </div>
                        <p class="text-[11px] text-slate-500 leading-tight">Sepanduk geometri berlapis, kad berikon gradien halus & garis masa visual.</p>
                    </button>

                    <button type="button" onclick="setTemplate('eksekutif_split')" id="tpl-btn-eksekutif_split" class="tpl-btn text-left p-3 rounded-xl border-2 border-slate-200 bg-white hover:border-slate-300 transition cursor-pointer">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-bold text-slate-900">Eksekutif Korporat</span>
                            <span class="w-2.5 h-2.5 rounded-full bg-transparent tpl-dot"></span>
                        </div>
                        <p class="text-[11px] text-slate-500 leading-tight">Panel sisi kiri menegak beridentiti penuh dengan ruangan naratif kanan.</p>
                    </button>

                    <button type="button" onclick="setTemplate('klasik')" id="tpl-btn-klasik" class="tpl-btn text-left p-3 rounded-xl border-2 border-slate-200 bg-white hover:border-slate-300 transition cursor-pointer">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-bold text-slate-900">Klasik Berprestij</span>
                            <span class="w-2.5 h-2.5 rounded-full bg-transparent tpl-dot"></span>
                        </div>
                        <p class="text-[11px] text-slate-500 leading-tight">Kepala rasmi berlapis emas/aksen, jadual formal agensi & bingkai kemas.</p>
                    </button>

                    <button type="button" onclick="setTemplate('bento')" id="tpl-btn-bento" class="tpl-btn sm:col-span-2 text-left p-3 rounded-xl border-2 border-slate-200 bg-white hover:border-slate-300 transition cursor-pointer">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-bold text-slate-900">Grid Modular Kontemporari (Bento Grid)</span>
                            <span class="w-2.5 h-2.5 rounded-full bg-transparent tpl-dot"></span>
                        </div>
                        <p class="text-[11px] text-slate-500 leading-tight">Susun atur kad modular 'Bento Box' dengan hierarki visual moden dan sudut kemas.</p>
                    </button>
                </div>

                <!-- Pilihan Gaya Bingkai Gambar -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Gaya Bingkai Gambar Dokumentasi</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" onclick="setPhotoFrame('bulat')" data-frame="bulat" class="frame-btn py-1.5 px-2 rounded-lg border-2 border-blue-900 bg-white text-[11px] font-bold text-slate-900 cursor-pointer transition">
                            Sudut Bulat
                        </button>
                        <button type="button" onclick="setPhotoFrame('tajam')" data-frame="tajam" class="frame-btn py-1.5 px-2 rounded-lg border border-slate-200 bg-white text-[11px] font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition">
                            Sudut Tajam
                        </button>
                        <button type="button" onclick="setPhotoFrame('polaroid')" data-frame="polaroid" class="frame-btn py-1.5 px-2 rounded-lg border border-slate-200 bg-white text-[11px] font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition">
                            Bingkai Polaroid
                        </button>
                    </div>
                </div>

                <!-- Ketetapan Saiz & Nisbah Paparan Gambar -->
                <div class="pt-2 border-t border-slate-200/80 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-semibold text-slate-700">Ketetapan Paparan & Saiz Gambar</label>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">Tanpa Potong</span>
                    </div>

                    <div class="grid grid-cols-1 gap-1.5">
                        <button type="button" onclick="setPhotoDisplayMode('full_original')" data-pmode="full_original" class="pmode-btn text-left px-3 py-2 rounded-xl border-2 border-blue-900 bg-white transition cursor-pointer">
                            <div class="flex items-center justify-between">
                                <span class="text-[11.5px] font-bold text-slate-900">Saiz Penuh Asal (Tanpa Potong)</span>
                                <span class="w-2 h-2 rounded-full bg-blue-900 pmode-dot"></span>
                            </div>
                            <p class="text-[10px] text-slate-500 leading-tight mt-0.5">Papar 100% keseluruhan gambar mengikut nisbah asal tanpa memotong tepi.</p>
                        </button>

                        <button type="button" onclick="setPhotoDisplayMode('uniform_contain')" data-pmode="uniform_contain" class="pmode-btn text-left px-3 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer">
                            <div class="flex items-center justify-between">
                                <span class="text-[11.5px] font-semibold text-slate-800">Ketinggian Tetap Seragam (Penuh)</span>
                                <span class="w-2 h-2 rounded-full bg-transparent pmode-dot"></span>
                            </div>
                            <p class="text-[10px] text-slate-500 leading-tight mt-0.5">Bingkai seragam kemas dengan keseluruhan gambar kekal penuh di dalam bingkai.</p>
                        </button>

                        <button type="button" onclick="setPhotoDisplayMode('custom')" data-pmode="custom" class="pmode-btn text-left px-3 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer">
                            <div class="flex items-center justify-between">
                                <span class="text-[11.5px] font-semibold text-slate-800">Ketetapan Saiz Tersuai (Tinggi & Nisbah)</span>
                                <span class="w-2 h-2 rounded-full bg-transparent pmode-dot"></span>
                            </div>
                            <p class="text-[10px] text-slate-500 leading-tight mt-0.5">Laras ketinggian maksimum, nisbah bingkai & mod muatan gambar secara manual.</p>
                        </button>
                    </div>

                    <!-- Kawalan Terperinci untuk Ketetapan Saiz Tersuai -->
                    <div id="custom-photo-controls" class="hidden p-3 rounded-xl bg-white border border-slate-200 space-y-2.5">
                        <div>
                            <div class="flex items-center justify-between text-[11px] mb-1">
                                <span class="font-semibold text-slate-700">Ketinggian Maksimum Gambar</span>
                                <span id="custom-height-label" class="font-bold text-blue-900">135px</span>
                            </div>
                            <input type="range" id="input-photo-height" min="80" max="220" step="5" value="135" oninput="updateCustomPhotoSettings()" class="w-full accent-blue-900 cursor-pointer">
                            <div class="flex justify-between text-[9.5px] text-slate-400">
                                <span>80px (Padat)</span>
                                <span>150px (Sederhana)</span>
                                <span>220px (Besar)</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10.5px] font-semibold text-slate-700 mb-1">Nisbah Bingkai</label>
                                <select id="input-photo-ratio" onchange="updateCustomPhotoSettings()" class="w-full px-2 py-1.5 text-[11px] bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:border-blue-900">
                                    <option value="auto">Auto Asal</option>
                                    <option value="16/9">16:9 (Landskap)</option>
                                    <option value="4/3">4:3 (Standard)</option>
                                    <option value="1/1">1:1 (Segi Empat)</option>
                                    <option value="3/4">3:4 (Potret)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10.5px] font-semibold text-slate-700 mb-1">Mod Paparan</label>
                                <select id="input-photo-fit" onchange="updateCustomPhotoSettings()" class="w-full px-2 py-1.5 text-[11px] bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:border-blue-900">
                                    <option value="contain">Papar Penuh (Contain)</option>
                                    <option value="cover">Isi Bingkai (Cover)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pilihan Warna Tema -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-2">Warna Korporat Utama</label>
                    <div class="flex flex-wrap items-center gap-2.5">
                        <button type="button" onclick="setThemeColor('biru')" data-color="biru" class="color-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border-2 border-blue-900 bg-white text-xs font-semibold text-slate-800 cursor-pointer">
                            <span class="w-3.5 h-3.5 rounded-full bg-[#1e3a8a]"></span> Biru Korporat
                        </button>
                        <button type="button" onclick="setThemeColor('zamrud')" data-color="zamrud" class="color-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer">
                            <span class="w-3.5 h-3.5 rounded-full bg-[#065f46]"></span> Hijau Zamrud
                        </button>
                        <button type="button" onclick="setThemeColor('marun')" data-color="marun" class="color-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer">
                            <span class="w-3.5 h-3.5 rounded-full bg-[#881337]"></span> Merah Marun
                        </button>
                        <button type="button" onclick="setThemeColor('kelabu')" data-color="kelabu" class="color-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer">
                            <span class="w-3.5 h-3.5 rounded-full bg-[#1e293b]"></span> Kelabu Eksekutif
                        </button>
                        <button type="button" onclick="setThemeColor('ungu')" data-color="ungu" class="color-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer">
                            <span class="w-3.5 h-3.5 rounded-full bg-[#4c1d95]"></span> Ungu Diraja
                        </button>
                    </div>
                </div>
            </div>

            <!-- Seksyen 2: Identiti Organisasi & Kepala Laporan -->
            <div class="space-y-4">
                <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-2">
                    <span class="w-6 h-6 rounded-lg bg-blue-900 text-white text-xs flex items-center justify-center font-bold">2</span>
                    Identiti Organisasi & Tajuk Laporan
                </h2>

                <!-- Muat Naik Logo -->
                <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-dashed border-slate-300">
                    <div id="logo-thumb-box" class="w-12 h-12 rounded-lg bg-white border border-slate-200 flex items-center justify-center overflow-hidden flex-shrink-0">
                        <svg id="logo-placeholder-icon" class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <img id="logo-thumb-img" src="" alt="Logo" class="hidden w-full h-full object-contain">
                    </div>
                    <div class="flex-1 min-w-0">
                        <label class="block text-xs font-bold text-slate-800">Logo Organisasi / Jabatan / Sekolah</label>
                        <p class="text-[11px] text-slate-500 truncate">Format PNG/JPG lutsinar disyorkan.</p>
                        <div class="mt-1.5 flex items-center gap-2">
                            <label class="inline-flex items-center px-2.5 py-1 bg-white border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer">
                                <span>Pilih Fail Logo</span>
                                <input type="file" id="input-logo" accept="image/*" class="hidden" onchange="handleLogoUpload(event)">
                            </label>
                            <button type="button" id="btn-remove-logo" onclick="removeLogo()" class="hidden text-xs text-rose-600 hover:underline font-medium cursor-pointer">Buang</button>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Organisasi / Jabatan / Sekolah</label>
