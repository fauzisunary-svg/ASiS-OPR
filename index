        async function generatePDF() {
            const btn = document.getElementById('btn-download-pdf');
            const originalHtml = btn.innerHTML;

            // Simpan salinan automatik ke dalam Pusat Rekod & Arkib OPR sebelum penjanaan PDF
            await saveCurrentOprToArchive('Dijana PDF', true);

            // Jika library html2pdf tidak tersedia, terus guna window.print()
            if (typeof html2pdf === 'undefined') {
                window.print();
                return;
            }

            try {
                btn.disabled = true;
                btn.innerHTML = `<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg><span>Menjana PDF...</span>`;
                showToast('Sedang menjana fail PDF A4 & menyimpan ke Arkib OPR...', 'info');

                // Klon elemen A4 pada skala 1:1 (tanpa transform scale) supaya hasil PDF tepat 210mm x 297mm
                const sourceDoc = document.getElementById('a4-document');
                const cloneContainer = document.createElement('div');
                cloneContainer.style.position = 'fixed';
                cloneContainer.style.left = '-10000px';
                cloneContainer.style.top = '0';
                cloneContainer.style.width = '210mm';
                cloneContainer.style.height = '296.8mm'; // Sedikit kurang dari 297mm bagi mengelak halaman ke-2 kosong
                cloneContainer.style.overflow = 'hidden';
                cloneContainer.style.background = '#ffffff';

                const clonedDoc = sourceDoc.cloneNode(true);
                clonedDoc.style.transform = 'none';
                clonedDoc.style.boxShadow = 'none';
                clonedDoc.style.margin = '0';
                clonedDoc.style.width = '210mm';
                clonedDoc.style.height = '296.8mm';
                cloneContainer.appendChild(clonedDoc);
                document.body.appendChild(cloneContainer);

                const safeTitle = (appState.title || 'One_Page_Report')
                    .replace(/[^a-zA-Z0-9\s-_]/g, '')
                    .trim()
                    .replace(/\s+/g, '_')
                    .substring(0, 45);

                const opt = {
                    margin: 0,
                    filename: `OPR_${safeTitle || 'Laporan_Rasmi'}.pdf`,
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: {
                        scale: 2,
