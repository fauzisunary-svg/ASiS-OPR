                timestamp: formatTimestampMY(now),
                createdAtMs: now.getTime(),
                userName: actor.name,
                staffId: actor.staffId,
                userRole: actor.role,
                userOrg: actor.org,
                action: actionType,
                details: details
            };
            await dbPut('logs', logEntry);
            await refreshAllCachedData();
        }

