        // =========================================================================
        // 6. PENGSKALAAN PRATONTON A4 RESPONSIF & ZOOM
        // =========================================================================
        function updatePreviewScale() {
            const wrapper = document.getElementById('preview-wrapper');
            const scaler = document.getElementById('preview-scaler');
            const doc = document.getElementById('a4-document');
            const zoomLabel = document.getElementById('zoom-label');

            if (!wrapper || !scaler || !doc || wrapper.offsetParent === null) return;

            // Saiz 210mm dalam piksel pada 96 DPI (~793.7px)
            const a4WidthPx = 793.7;
            const a4HeightPx = 1122.5;
            const availableWidth = wrapper.clientWidth - 48; // padding

            let scale = customZoom !== null
                ? customZoom
                : Math.min(1, Math.max(0.35, availableWidth / a4WidthPx));

            doc.style.transform = `scale(${scale})`;
            scaler.style.width = `${a4WidthPx * scale}px`;
            scaler.style.height = `${a4HeightPx * scale}px`;

            zoomLabel.textContent = customZoom !== null
                ? `${Math.round(scale * 100)}%`
                : `Auto (${Math.round(scale * 100)}%)`;
        }

        function adjustZoom(delta) {
            const doc = document.getElementById('a4-document');
            const currentTransform = doc.style.transform;
            const match = currentTransform.match(/scale\(([^)]+)\)/);
            const current = match ? parseFloat(match[1]) : 0.8;
            customZoom = Math.min(1.4, Math.max(0.35, +(current + delta).toFixed(2)));
            updatePreviewScale();
        }

        function resetZoom() {
            customZoom = null;
            updatePreviewScale();
        }

