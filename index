<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Penjana One Page Report (OPR) Rasmi</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans, Merriweather & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;0,900;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- html2pdf.js untuk muat turun PDF terus -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <style>
        :root {
            --theme-primary: #1e3a8a;
            --theme-secondary: #1e40af;
            --theme-light: #eff6ff;
            --theme-accent: #d97706;
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            background-color: #f1f5f9;
        }

        .font-serif-formal {
            font-family: 'Merriweather', serif;
        }

        .font-inter {
            font-family: 'Inter', sans-serif;
        }

        /* Saiz Sebenar Kertas A4 (210mm x 297mm) */
        .a4-page {
            width: 210mm;
            height: 297mm;
            min-width: 210mm;
            min-height: 297mm;
            max-width: 210mm;
            max-height: 297mm;
            background: #ffffff;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.12), 0 10px 10px -5px rgba(0, 0, 0, 0.06);
            overflow: hidden;
            position: relative;
            box-sizing: border-box;
            transform-origin: top center;
            transition: transform 0.2s ease;
        }

        /* Custom Scrollbar untuk Panel Borang */
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Konfigurasi Khas Cetakan & Save as PDF */
        @media print {
            @page {
                size: A4 portrait;
                margin: 0;
            }
            html, body {
                width: 210mm;
                height: 297mm;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                overflow: hidden !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print {
                display: none !important;
            }
            #preview-wrapper {
                padding: 0 !important;
                margin: 0 !important;
                background: transparent !important;
                overflow: visible !important;
                display: block !important;
                width: 210mm !important;
                height: 297mm !important;
            }
            #preview-scaler {
                transform: none !important;
                width: 210mm !important;
                height: 297mm !important;
                margin: 0 !important;
            }
            .a4-page {
                box-shadow: none !important;
                margin: 0 !important;
                transform: none !important;
                width: 210mm !important;
                height: 297mm !important;
                page-break-after: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body class="text-slate-800 antialiased selection:bg-blue-100 selection:text-blue-900">

    <!-- Gerbang Log Masuk & Pendaftaran Pengguna (Auth Gate) -->
    <div id="auth-gate" class="no-print fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white w-full max-w-4xl rounded-3xl shadow-2xl border border-slate-200 overflow-hidden grid grid-cols-1 lg:grid-cols-12 my-auto">
            <!-- Panel Kiri: Maklumat Sistem -->
            <div class="lg:col-span-5 bg-gradient-to-br from-blue-950 via-blue-900 to-indigo-900 text-white p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden">
                <div class="relative z-10">
                    <div class="w-12 h-12 rounded-2xl bg-white/15 border border-white/25 flex items-center justify-center mb-5">
                        <svg class="w-7 h-7 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-widest bg-amber-400/20 text-amber-300 border border-amber-300/30 mb-2">Portal Pelaporan Rasmi</span>
                    <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight leading-snug">Sistem Penjana One Page Report (OPR)</h2>
                    <p class="text-xs sm:text-sm text-blue-100/85 mt-2 leading-relaxed">
                        Platform pelaporan rasmi satu muka surat A4 yang dilengkapi arkib penyimpanan rekod automatik dan jejak audit penggunaan pengguna.
                    </p>

                    <div class="mt-6 space-y-2.5 text-xs text-blue-100">
                        <div class="flex items-center gap-2.5">
                            <span class="w-5 h-5 rounded-full bg-emerald-500/25 text-emerald-300 flex items-center justify-center font-bold">✓</span>
                            <span>5 Rekabentuk Pelaporan Rasmi & Kreatif (A4)</span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <span class="w-5 h-5 rounded-full bg-emerald-500/25 text-emerald-300 flex items-center justify-center font-bold">✓</span>
                            <span>Arkib Salinan OPR & Gambar Resolusi Penuh</span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <span class="w-5 h-5 rounded-full bg-emerald-500/25 text-emerald-300 flex items-center justify-center font-bold">✓</span>
                            <span>Rekod Pengguna Berdaftar & Log Penggunaan</span>
                        </div>
                    </div>
                </div>

                <div class="relative z-10 mt-6 pt-4 border-t border-white/15">
                    <p class="text-[11px] text-blue-200/80 mb-2">Ingin menguji sistem dengan pantas tanpa mendaftar?</p>
                    <button type="button" onclick="quickDemoLogin()" class="w-full py-2.5 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs transition shadow-md cursor-pointer flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        <span>Log Masuk Pantas (Akaun Demo)</span>
                    </button>
                </div>
            </div>

            <!-- Panel Kanan: Tab Log Masuk & Daftar Pengguna -->
            <div class="lg:col-span-7 p-6 sm:p-8 bg-white">
                <div class="flex border-b border-slate-200 mb-5">
                    <button type="button" id="auth-tab-login" onclick="switchAuthTab('login')" class="flex-1 pb-3 text-xs sm:text-sm font-extrabold border-b-2 border-blue-900 text-blue-900 transition cursor-pointer">
                        Log Masuk Pengguna
                    </button>
                    <button type="button" id="auth-tab-register" onclick="switchAuthTab('register')" class="flex-1 pb-3 text-xs sm:text-sm font-bold border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition cursor-pointer">
                        Daftar Pengguna Baharu
                    </button>
                </div>

                <!-- Borang Log Masuk -->
                <form id="form-login" onsubmit="handleLoginSubmit(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">ID Kakitangan / No. Kad Pengenalan / E-mel Rasmi</label>
                        <input type="text" id="login-identifier" required placeholder="Masukkan ID Pengguna atau E-mel berdaftar" class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Kata Laluan</label>
                        <input type="password" id="login-password" required placeholder="Masukkan kata laluan anda" class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                    </div>
                    <div id="login-error-msg" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs font-semibold text-rose-700"></div>

                    <button type="submit" class="w-full py-3 px-4 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-sm shadow-sm transition cursor-pointer">
                        Log Masuk ke Sistem
                    </button>

                    <div id="saved-accounts-quick" class="pt-3 border-t border-slate-100 hidden">
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Akaun Berdaftar di Peranti Ini:</p>
                        <div id="saved-accounts-list" class="flex flex-wrap gap-1.5"></div>
                    </div>
                </form>

                <!-- Borang Daftar Pengguna Baharu -->
                <form id="form-register" onsubmit="handleRegisterSubmit(event)" class="hidden space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11.5px] font-bold text-slate-700 mb-1">Nama Penuh <span class="text-rose-600">*</span></label>
                            <input type="text" id="reg-name" required placeholder="Contoh: AHMAD BIN ALI" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                        </div>
                        <div>
                            <label class="block text-[11.5px] font-bold text-slate-700 mb-1">No. KP / ID Kakitangan <span class="text-rose-600">*</span></label>
                            <input type="text" id="reg-staffid" required placeholder="Contoh: KPM-880101" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11.5px] font-bold text-slate-700 mb-1">Jawatan <span class="text-rose-600">*</span></label>
                            <input type="text" id="reg-role" required placeholder="Contoh: Pegawai Tadbir / Guru" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                        </div>
                        <div>
                            <label class="block text-[11.5px] font-bold text-slate-700 mb-1">Bahagian / Unit / Organisasi <span class="text-rose-600">*</span></label>
                            <input type="text" id="reg-org" required placeholder="Contoh: SMK Seri Perdana" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11.5px] font-bold text-slate-700 mb-1">E-mel Rasmi <span class="text-rose-600">*</span></label>
                            <input type="email" id="reg-email" required placeholder="nama@organisasi.gov.my" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                        </div>
                        <div>
                            <label class="block text-[11.5px] font-bold text-slate-700 mb-1">No. Telefon <span class="text-rose-600">*</span></label>
                            <input type="tel" id="reg-phone" required placeholder="Contoh: 012-3456789" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                        </div>
                    </div>

                    <div>
                        <label class="block text-[11.5px] font-bold text-slate-700 mb-1">Kata Laluan <span class="text-rose-600">*</span></label>
                        <input type="password" id="reg-password" required minlength="4" placeholder="Minimum 4 aksara" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                    </div>

                    <div id="reg-error-msg" class="hidden p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-xs font-semibold text-rose-700"></div>

                    <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs sm:text-sm shadow-sm transition cursor-pointer">
                        Daftar & Masuk ke Sistem
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Pusat Rekod & Arkib Salinan OPR -->
    <div id="modal-opr-archive" class="no-print hidden fixed inset-0 z-40 bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-6">
        <div class="bg-white w-full max-w-6xl max-h-[90vh] rounded-3xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden">
            <!-- Kepala Modal -->
            <div class="px-5 py-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3 bg-slate-50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-blue-900 text-white flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900">Pusat Rekod & Arkib Salinan OPR</h3>
                        <p class="text-xs text-slate-500">Semua salinan OPR yang dijana atau disimpan direkodkan secara automatik beserta gambar penuh.</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="exportArchiveCSV()" class="px-3 py-1.5 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 text-xs font-bold text-slate-700 cursor-pointer">
                        Eksport CSV
                    </button>
                    <button type="button" onclick="exportFullBackupJSON()" class="px-3 py-1.5 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 text-xs font-bold text-slate-700 cursor-pointer">
                        Sandaran JSON
                    </button>
                    <label class="px-3 py-1.5 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 text-xs font-bold text-slate-700 cursor-pointer">
                        Pulih JSON
                        <input type="file" accept=".json" class="hidden" onchange="importFullBackupJSON(event)">
                    </label>
                    <button type="button" onclick="closeModal('modal-opr-archive')" class="p-2 rounded-xl bg-slate-200/70 hover:bg-slate-300 text-slate-700 cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Bar Carian & Penapis -->
            <div class="px-5 py-3 border-b border-slate-200 bg-white flex flex-wrap items-center gap-3">
                <div class="flex-1 min-w-[220px] relative">
                    <input type="text" id="archive-search-input" oninput="renderArchiveList()" placeholder="Cari tajuk program, lokasi, rujukan OPR, atau penyedia..." class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900">
                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
                <select id="archive-filter-template" onchange="renderArchiveList()" class="px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-700">
                    <option value="all">Semua Templat Rekabentuk</option>
                    <option value="editorial">Editorial Majalah</option>
                    <option value="infografik">Infografik Moden</option>
                    <option value="eksekutif_split">Eksekutif Korporat</option>
                    <option value="klasik">Klasik Berprestij</option>
                    <option value="bento">Grid Modular Bento</option>
                </select>
                <select id="archive-filter-status" onchange="renderArchiveList()" class="px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-700">
                    <option value="all">Semua Status Rekod</option>
                    <option value="Dijana PDF">Dijana PDF</option>
                    <option value="Disimpan Manual">Disimpan Manual</option>
                </select>
            </div>

            <!-- Senarai Kad Arkib OPR -->
            <div id="archive-list-container" class="flex-1 overflow-y-auto custom-scrollbar p-5 bg-slate-100/60">
                <!-- Kandungan dijana secara dinamik -->
            </div>
        </div>
    </div>

    <!-- Modal Ringkasan Rekod OPR -->
    <div id="modal-record-detail" class="no-print hidden fixed inset-0 z-50 bg-slate-900/75 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-2xl max-h-[85vh] rounded-3xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden">
            <div class="px-5 py-3.5 border-b border-slate-200 flex items-center justify-between bg-slate-50">
                <h4 class="text-sm font-extrabold text-slate-900">Butiran Terperinci Salinan Rekod OPR</h4>
                <button type="button" onclick="closeModal('modal-record-detail')" class="p-1.5 rounded-lg hover:bg-slate-200 text-slate-600 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div id="record-detail-body" class="p-5 overflow-y-auto custom-scrollbar space-y-4 text-xs"></div>
        </div>
    </div>

    <!-- Modal Rekod Pengguna Berdaftar & Log Penggunaan Sistem -->
    <div id="modal-system-logs" class="no-print hidden fixed inset-0 z-40 bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-6">
        <div class="bg-white w-full max-w-6xl max-h-[90vh] rounded-3xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden">
            <!-- Kepala Modal -->
            <div class="px-5 py-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3 bg-slate-50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-800 text-white flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900">Rekod Pengguna Berdaftar & Jejak Penggunaan Sistem</h3>
                        <p class="text-xs text-slate-500">Pemantauan pendaftaran pengguna dan log aktiviti penjanaan pelaporan secara masa nyata.</p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('modal-system-logs')" class="p-2 rounded-xl bg-slate-200/70 hover:bg-slate-300 text-slate-700 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Kad Statistik Ringkas -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 bg-white border-b border-slate-200">
                <div class="p-3 rounded-2xl bg-blue-50 border border-blue-200">
                    <span class="text-[11px] font-bold text-blue-800 uppercase block">Pengguna Berdaftar</span>
                    <span id="stat-total-users" class="text-xl font-black text-blue-950">0</span>
                </div>
                <div class="p-3 rounded-2xl bg-emerald-50 border border-emerald-200">
                    <span class="text-[11px] font-bold text-emerald-800 uppercase block">Aktiviti Penggunaan</span>
                    <span id="stat-total-logs" class="text-xl font-black text-emerald-950">0</span>
                </div>
                <div class="p-3 rounded-2xl bg-amber-50 border border-amber-200">
                    <span class="text-[11px] font-bold text-amber-800 uppercase block">Salinan OPR Disimpan</span>
                    <span id="stat-total-oprs" class="text-xl font-black text-amber-950">0</span>
                </div>
                <div class="p-3 rounded-2xl bg-purple-50 border border-purple-200">
                    <span class="text-[11px] font-bold text-purple-800 uppercase block">PDF Rasmi Dijana</span>
                    <span id="stat-total-pdfs" class="text-xl font-black text-purple-950">0</span>
                </div>
            </div>

            <!-- Sub-Tab: Senarai Pengguna vs Log Penggunaan -->
            <div class="px-5 pt-2 bg-slate-50 border-b border-slate-200 flex items-center justify-between flex-wrap gap-2">
                <div class="flex gap-2">
                    <button type="button" id="subtab-logs-btn" onclick="switchAdminSubtab('logs')" class="px-4 py-2 text-xs font-extrabold rounded-t-xl bg-white border-t border-x border-slate-200 text-blue-900 cursor-pointer">
                        Log Penggunaan Sistem (Jejak Audit)
                    </button>
                    <button type="button" id="subtab-users-btn" onclick="switchAdminSubtab('users')" class="px-4 py-2 text-xs font-bold rounded-t-xl text-slate-600 hover:text-slate-900 cursor-pointer">
                        Senarai Pengguna Berdaftar
                    </button>
                </div>

                <div class="pb-2 flex items-center gap-2">
                    <button type="button" onclick="exportUsersCSV()" class="px-3 py-1 rounded-lg bg-white border border-slate-300 hover:bg-slate-100 text-[11px] font-bold text-slate-700 cursor-pointer">
                        Eksport Pengguna (CSV)
                    </button>
                    <button type="button" onclick="exportLogsCSV()" class="px-3 py-1 rounded-lg bg-white border border-slate-300 hover:bg-slate-100 text-[11px] font-bold text-slate-700 cursor-pointer">
                        Eksport Log (CSV)
                    </button>
                </div>
            </div>

            <!-- Kandungan Sub-Tab Log Penggunaan -->
            <div id="subtab-logs-panel" class="flex-1 overflow-y-auto custom-scrollbar p-4 space-y-3">
                <div class="flex flex-wrap items-center gap-2">
